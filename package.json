{
  "name": "tracelab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:electron": "cross-env BUILD_TARGET=electron vite build",
    "package:win": "npm run build:electron && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/utils test/canvas",
    "test:integration": "vitest run test/integration"
  },
  "build": {
    "appId": "com.nickcason.tracelab",
    "productName": "TraceLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "TraceLab-portable.exe"
    },
    "portable": {
      "artifactName": "TraceLab-portable.exe"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.4",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.8.9",
    "vite": "^5.4.10",
    "vitest": "^4.1.4"
  }
}
