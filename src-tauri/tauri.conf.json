{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraceLab",
  "version": "0.1.0",
  "identifier": "com.nickcason.tracelab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "vite build --mode tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TraceLab",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#1a1a1e",
        "visible": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
